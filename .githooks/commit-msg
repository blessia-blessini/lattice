#!/usr/bin/env bash
# commit-msg hook — auto-insert the commit title into CHANGELOG.md
#
# Fires after the user writes the commit message, before the commit is
# finalised. git add inside here includes changes in the same commit,
# so no separate "update changelog" commit is created.
#
# To skip for one commit, put [skip-changelog] anywhere in the message.

COMMIT_MSG_FILE="$1"
COMMIT_TITLE=$(head -1 "$COMMIT_MSG_FILE" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

# DEBUG — top of hook, always fires
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
echo "=== $(date) | TITLE='$COMMIT_TITLE' | MSG_FILE='$COMMIT_MSG_FILE'" >> "$SCRIPT_DIR/debug-changelog.log"

# Skip conditions
[ -z "$COMMIT_TITLE" ] && exit 0

git rev-parse --verify MERGE_HEAD > /dev/null 2>&1 && exit 0
[ -n "$GIT_REBASE_HEAD" ] && exit 0

case "$COMMIT_TITLE" in
  Merge\ *|Revert\ *|fixup\!*|squash\!*|"chore(changelog):"*) exit 0 ;;
esac

[[ "$COMMIT_TITLE" == *"[skip-changelog]"* ]] && exit 0

# Update CHANGELOG.md
REPO_ROOT=$(git rev-parse --show-toplevel)

BINARY="$REPO_ROOT/.githooks/changelog-update"
[ -f "$BINARY" ] || BINARY="$REPO_ROOT/.githooks/changelog-update.exe"
[ -f "$BINARY" ] || exit 0

# cd to repo root so binary and git-add both use plain relative paths,
# avoiding all MSYS/Win32 path-conversion issues.
cd "$REPO_ROOT" || exit 0
[ -f "CHANGELOG.md" ] || exit 0

BINARY_OUT=$("$BINARY" "$COMMIT_TITLE" "CHANGELOG.md" 2>&1)
BINARY_EXIT=$?

ADD_OUT=$(git add CHANGELOG.md 2>&1)
ADD_EXIT=$?

# Debug log — remove once confirmed working
LOG="$REPO_ROOT/.githooks/debug-changelog.log"
{
  echo "=== $(date) ==="
  echo "TITLE:        $COMMIT_TITLE"
  echo "BINARY:       $BINARY"
  echo "BINARY_EXIT:  $BINARY_EXIT"
  echo "BINARY_OUT:   $BINARY_OUT"
  echo "ADD_EXIT:     $ADD_EXIT"
  echo "ADD_OUT:      $ADD_OUT"
  echo "CHANGELOG_MD: $(cat CHANGELOG.md | grep -A3 '### Changed' | head -5)"
} >> "$LOG"

exit 0
