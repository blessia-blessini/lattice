{
  "name": "lattice",
  "private": true,
  "version": "0.2.39",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-wrapper.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "doc": "typedoc --plugin typedoc-plugin-markdown --out docs/gen/frontend --entryFileName frontend-readme.md --entryPointStrategy expand ./src --exclude \"**/*.test.tsx\" --exclude \"**/test/**\"",
    "clean": "rimraf dist node_modules/.vite src-tauri/target"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@uiw/codemirror-themes": "^4.25.3",
    "@uiw/codemirror-themes-all": "^4.25.3",
    "codemirror": "^6.0.2",
    "github-markdown-css": "^5.8.1",
    "katex": "^0.16.28",
    "mermaid": "^11.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^27.4.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "uuid": "^14.0.0"
  }
}
