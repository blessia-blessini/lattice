      "linkage": "separate-program",
      "platforms": [
        "linux-x64",
        "linux-arm64"
      ],
      "appImage": {
        "runtimeCommit": "fedfad5"
      }
    },
    {
      "name": "libfuse (in the AppImage type 2 runtime)",
