{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "vite.config.ts",
    "vite-release-guard.ts"
  ]
}